RADIX	10
;
; WHAT THE C64 ADDS: THE KERNAL CALLS THAT CHECK FOR AN ERROR, SYS,
; LOAD AND THE OTHER FILE STATEMENTS, AND A START THAT SETS UP PAGE
; ZERO AND THE VECTORS AT $0300.
;
IOERR:	LDXI	ERRBD		;ANY KERNAL ERROR.
	JMP	ERROR
COUT:	JSR	OUTCH
	BCS	IOERR
	RTS
CIN:	JSR	CQINCH
	BCS	IOERR
	RTS
CCKOUT: JSR	CQOOUT
	BCS	IOERR
	RTS
CCHKIN: JSR	CQOIN
	BCS	IOERR
	RTS
CGETIN: JSR	CZGETL
	BCS	IOERR
	RTS
;
; SYS ADDRESS: THE REGISTERS FROM $030C-$030F, AND BACK THERE AFTER.
;
SAREG=^D780
SXREG=^D781
SYREG=^D782
SPREG=^D783
SYS:	JSR	FRMNUM
	JSR	GETADR
	LDAI	<<SYSRET-1>/256>
	PHA
	LDAI	<<SYSRET-1>&255>
	PHA
	LDA	SPREG
	PHA
	LDA	SAREG
	LDX	SXREG
	LDY	SYREG
	PLP
	JMPD	LINNUM
SYSRET: PHP
	STA	SAREG
	STX	SXREG
	STY	SYREG
	PLA
	STA	SPREG
	RTS
;
; THERE IS NO DRIVE OR TAPE HERE: LOAD, SAVE AND VERIFY FIND NO DEVICE,
; OPEN AND CLOSE ONLY TAKE THEIR ARGUMENTS.
;
LOAD:
SAVE:
VERIFY: LDXI	ERRBD
	JMP	ERROR
OPEN:
CLOSE:	JMP	DATA
RADIX	8
