PAGE
SUBTTL	C64 STARTUP AND THE KERNAL CALLS.
RADIX	10
;
; WARM START (RESTORE) AND COLD START, WHERE THE C64 HAS THEM.
;
WARM:	JMP	READY
INIT:	JSR	INITV
	JSR	INITCZ
	JSR	INITMS
	LDXI	STKEND-256
	TXS
	BNE	WARM		;ALWAYS.
;
; THE CHRGET ROUTINE AND THE FIRST RANDOM NUMBER, COPIED TO PAGE ZERO.
;
INITAT: INC	CHRGET+7	;INCREMENT THE WHOLE TXTPTR.
	BNE	CHZGOT
	INC	CHRGET+8
CHZGOT: LDA	60000		;A LOAD WITH AN EXT ADDR.
	CMPI	":"		;IS IT A ":"?
	BCS	CHZRTS		;IT IS .GE. ":"
	CMPI	" "		;SKIP SPACES.
	BEQ	INITAT
	SEC
	SBCI	"0"
	SEC
	SBCI	^D256-"0"
CHZRTS: RTS
	128			;THE INITIAL RANDOM NUMBER.
	79
	199
	82
	88
;
; PAGE ZERO AS A COLD START LEAVES IT - WHERE THE C64 HAS IT, AS TUNES
; CALL IT THERE.
;
INITCZ: LDAI	76		;JMP INSTRUCTION.
	STA	JMPER
	STA	USRPOK
	LDWDI	FCERR
	STWD	USRPOK+1
	LDWDI	AYINT
	STWD	3		;C64: ADRAY1
	LDWDI	GIVAYF
	STWD	5		;C64: ADRAY2
	LDXI	RNDX+4-CHRGET
MOVCHG: LDA	INITAT,X,
	STA	CHRGET,X,	;MOVE TO RAM.
	DEX
	BPL	MOVCHG
	LDAI	STRSIZ
	STA	FOUR6
	LDAI	0
	STA	BITS
	STA	CHANNL
	STA	LASTPT+1
	LDXI	1		;PRE-BUF BYTES NON-ZERO FOR CHEAD.
	STX	BUF-3
	STX	BUF-4
	LDXI	TEMPST
	STX	TEMPPT		;SET UP STRING TEMPORARIES.
	LDWDI	^O4000		;THE TEXT STARTS AT $0800,
	STWD	TXTTAB
	LDWDI	ROMLOC		;AND MEMORY ENDS AT $A000.
	STWD	MEMSIZ
	STWD	FRETOP
	LDYI	0
	TYA
	STADY	TXTTAB		;A ZERO BEFORE THE TEXT.
	INC	TXTTAB
	RTS
;
; THE GREETING AND THE MEMORY FREE, THEN NEW.
;
INITMS: LDWD	TXTTAB
	JSR	REASON
	LDWDI	MSG1
	JSR	STROUT
	LDA	MEMSIZ
	SEC
	SBC	TXTTAB
	TAX
	LDA	MEMSIZ+1
	SBC	TXTTAB+1
	JSR	LINPRT
	LDWDI	MSG2
	JSR	STROUT
	JMP	SCRTCH
;
; THE VECTORS AT $0300: ERRORS, THE MAIN LOOP, CRUNCH, LIST, THE NEXT
; STATEMENT AND EVAL. ONLY THE LAST TWO ARE GONE THROUGH HERE.
;
VECTRS: ADR(ERROR)
	ADR(MAIN)
	ADR(CRUNC2)
	ADR(LIST)
	ADR(GONE)
	ADR(EVALC)
INITV:	LDXI	11
INITV1: LDA	VECTRS,X
	STA	^O1400,X
	DEX
	BPL	INITV1
	RTS
;
; THE GREETING: AS MANY LINES AS THE C64'S, SO THE CURSOR IS WHERE IT
; WOULD BE.
;
MSG1:	147
	13
	DT"    **** 6502 BASIC V2 ****"
	13
	13
	DT" 64K RAM SYSTEM  "
	0
MSG2:	DT" BASIC BYTES FREE"
	13
	0
;
; RUN THE PROGRAM IN MEMORY - LOADED, WITH [VARTAB] AT ITS END - AS
; TYPING RUN DOES.
;
RUNPRG: LDXI	255		;DIRECT, AS TYPED.
	STX	CURLIN+1
	LDXI	STKEND-256
	TXS
	LDAI	0
	JSR	SETMSG
	JSR	RUNC
	JMP	NEWSTT
ROMEND:
