    <ProjectReference Include="..\MagPlay.Score\MagPlay.Score.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MagPlay.Transcribe.Tests" />
  </ItemGroup>

</Project>
