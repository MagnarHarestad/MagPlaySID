<Project Sdk="Microsoft.NET.Sdk">

  <!-- MagPlaySID: plays .sid tunes with the MagSID player's visualisation, and shows each tune
       transcribed into tracker rows that scroll with the music. Read-only. See docs/PLAN.md. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>MagPlaySID</AssemblyName>
    <RootNamespace>MagPlaySid</RootNamespace>
    <Version>1.21</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationIcon>MagPlaySID.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- The website's logo as the app's icon, 16 to 256 pixels: on the .exe as ApplicationIcon, and
       embedded for the window's title bar and taskbar on every system. -->
  <ItemGroup>
    <EmbeddedResource Include="MagPlaySID.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MagSid.Playback\MagSid.Playback.csproj" />
    <ProjectReference Include="..\MagPlay.Transcribe\MagPlay.Transcribe.csproj" />
    <ProjectReference Include="..\MagSid.Audio.PortAudio\MagSid.Audio.PortAudio.csproj" />
    <PackageReference Include="Avalonia" Version="11.3.20" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.20" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.20" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.20" />
    <!-- The sheet music's PDF: Skia writes it - the version Avalonia draws the window with. -->
    <PackageReference Include="SkiaSharp" Version="2.88.9" />
  </ItemGroup>

</Project>
