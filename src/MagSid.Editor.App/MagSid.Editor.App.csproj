<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\MagSid.Core\MagSid.Core.csproj" />
    <ProjectReference Include="..\MagSid.Assembler\MagSid.Assembler.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- MIDI input for the DAW's knobs and step entry. Same package family as the audio, so
         nothing new travels with the single-file build. -->
    <PackageReference Include="NAudio.Midi" Version="2.2.1" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <ProjectReference Include="..\MagSid.Playback\MagSid.Playback.csproj" />
    <ProjectReference Include="..\MagSid.Editor.Common\MagSid.Editor.Common.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- The file Magnar actually double-clicks. The project keeps its own name; only the built
         assembly is renamed, so the .exe and its .dll are MagSID-Editor.* -->
    <AssemblyName>MagSID-Editor</AssemblyName>
    <!-- The editor's version: what About shows and what the .exe's properties say. -->
    <Version>1.51</Version>
    <TargetFramework>net8.0-windows</TargetFramework>
    <!-- Runs on any Desktop Runtime from 8 upwards. Without it a machine carrying only .NET 9 or
         10 refuses to start the app although its runtime is newer than the one asked for, which is
         what a user hit on 2026-09-30 with ".NET 8+ installed". -->
    <RollForward>Major</RollForward>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>MagSID.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Embedded as well as set as ApplicationIcon: the latter only puts it on the .exe for
         Explorer/taskbar, while Form.Icon needs to load it at runtime. See AppIcon.cs. -->
    <EmbeddedResource Include="MagSID.ico" />
  </ItemGroup>

  <!-- Everything the app needs except its own four files goes into Addons\, so the folder shows
       the .exe rather than twenty DLLs. Program.Main registers a resolver for that folder before
       anything is loaded from it - the runtime only looks beside the .exe on its own. -->
  <!-- Skipped when publishing: a single-file publish bundles the dependencies into the .exe
       itself, and moving them aside first would take them out from under the bundler. -->
  <Target Name="CollectDependenciesIntoAddons" AfterTargets="Build"
          Condition="'$(_IsPublishing)' != 'true'">
    <ItemGroup>
      <AddonFile Include="$(OutDir)*.dll;$(OutDir)*.pdb"
                 Exclude="$(OutDir)$(AssemblyName).dll;$(OutDir)$(AssemblyName).pdb" />
    </ItemGroup>
    <Move SourceFiles="@(AddonFile)" DestinationFolder="$(OutDir)Addons" ContinueOnError="true" />
  </Target>

</Project>