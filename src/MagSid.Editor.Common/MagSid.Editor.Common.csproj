<Project Sdk="Microsoft.NET.Sdk">

  <!-- What both editors share and no UI touches: the open song and its history, settings, the
       pattern clipboard and the .sid export. The namespaces stay those of the Windows editor, where
       these files grew up, so neither editor has to say where they live now. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>MagSid.Editor.App</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MagSid.Core\MagSid.Core.csproj" />
    <ProjectReference Include="..\MagSid.Assembler\MagSid.Assembler.csproj" />
    <ProjectReference Include="..\MagSid.Sid\MagSid.Sid.csproj" />
  </ItemGroup>

</Project>
