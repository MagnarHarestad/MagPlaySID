<Project Sdk="Microsoft.NET.Sdk">

  <!-- The editor's owner-drawn views, shared with the Windows editor source for source: the files
       are linked from MagSid.Editor.App unchanged and compile here against Shim/, a WinForms and
       GDI+ face over Avalonia. What one editor gains, the other has. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>MagSid.Editor.App</RootNamespace>
    <NoWarn>$(NoWarn);CS0108;CS0114</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MagSID" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="System.Drawing" />
    <Using Include="System.Windows.Forms" />
    <Using Include="Avalonia.Input.Cursor" Alias="Cursor" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MagSid.Core\MagSid.Core.csproj" />
    <ProjectReference Include="..\MagSid.Playback\MagSid.Playback.csproj" />
    <ProjectReference Include="..\MagSid.Editor.Common\MagSid.Editor.Common.csproj" />
    <PackageReference Include="Avalonia" Version="11.3.20" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\MagSid.Editor.App\EditorPalette.cs" Link="Linked\EditorPalette.cs" />
    <Compile Include="..\MagSid.Editor.App\PianoKeyMap.cs" Link="Linked\PianoKeyMap.cs" />
    <Compile Include="..\MagSid.Editor.App\Controls\TrackerGridControl.cs" Link="Linked\Controls\TrackerGridControl.cs" />
    <Compile Include="..\MagSid.Editor.App\Daw\*.cs" Link="Linked\Daw\%(Filename)%(Extension)" />
    <Compile Include="..\MagSid.Editor.App\Midi\MidiKnobBindings.cs" Link="Linked\Midi\MidiKnobBindings.cs" />
    <Compile Include="..\MagSid.Editor.App\AutosaveManager.cs" Link="Linked\AutosaveManager.cs" />
    <Compile Include="..\MagSid.Editor.App\AboutDocument.cs" Link="Linked\AboutDocument.cs" />
    <Compile Include="..\MagSid.Editor.App\SignalPathTrace.cs" Link="Linked\SignalPathTrace.cs" />
    <Compile Include="..\MagSid.Editor.App\SignalPathCanvas.cs" Link="Linked\SignalPathCanvas.cs" />
    <Compile Include="..\MagSid.Editor.App\DigiEncoder.cs" Link="Linked\DigiEncoder.cs" />
    <Compile Include="..\MagSid.Editor.App\DigiCanvas.cs" Link="Linked\DigiCanvas.cs" />
    <Compile Include="..\MagSid.Editor.App\Player\LiveRasterTime.cs" Link="Linked\Player\LiveRasterTime.cs" />
  </ItemGroup>

</Project>
