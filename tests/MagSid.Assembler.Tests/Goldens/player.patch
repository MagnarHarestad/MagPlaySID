+-- "1xx" slides up, "2xx" down, xx in hex - a row in place of a note. nil for anything else.
+local function SlideRate(note)
+    local dir, hex = note:match("^([12])(%x%x)$")
+    if not dir then
+        return nil
+    end
+    local rate = tonumber(hex, 16)
+    if dir == "2" then rate = -rate end
+    assert(rate >= -128 and rate <= 127, "slide out of range: " .. note)
+    return rate
+end
+
 -- "LE" (bare, loops forever) or "LE04" etc (finite repeat count, N times total).
 local function IsLE(tu)
     return tu == "LE" or tu:match("^LE%d+$") ~= nil
